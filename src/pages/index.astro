
---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <h1>Welcome to Lavender Nails</h1>
    <p>Your destination for beautiful nails and relaxing self-care.</p>


<img
  src="/images/manicure.jpg"
  alt="Beautiful manicure at Lavender Nails"
  class="hero-image"
/>


    <h2>Our Services</h2>
    <ul>
      <li>Manicures</li>
      <li>Pedicures</li>
      <li>Gel Nails</li>
      <li>Nail Art</li>
    </ul>

    <h2>About Us</h2>
    <p>
      At Lavender Nails, we are dedicated to helping our clients
      look and feel their best through professional nail care
      and a welcoming salon experience.
    </p>
  </main>
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 60px auto;
    padding: 40px;
    font-family: Arial, sans-serif;
    color: #4b365f;
    background-color: #faf5ff;
    border-radius: 16px;
  }

  h1 {
    color: #8254a3;
    font-size: 42px;
  }

  h2 {
    color: #8254a3;
    margin-top: 35px;
  }

  p, li {
    font-size: 18px;
    line-height: 1.7;
  }


.hero-image {
  display: block;
  width: 100%;
  max-height: 420px;
  object-fit: cover;
  border-radius: 14px;
  margin: 30px 0;
}
</style>

